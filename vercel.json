{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/", "destination": "/Home.dc.html" },
    { "source": "/work", "destination": "/Work.dc.html" },
    { "source": "/what-we-do", "destination": "/WhatWeDo.dc.html" },
    { "source": "/about", "destination": "/About.dc.html" },
    { "source": "/technology", "destination": "/Technology.dc.html" },
    { "source": "/insights", "destination": "/Insights.dc.html" },
    { "source": "/contact", "destination": "/Contact.dc.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
